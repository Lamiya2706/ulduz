# Edge Function secrets — set with:  supabase secrets set --env-file supabase/.env
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
SITE_URL=https://ulduz.az
ALLOWED_ORIGINS=https://ulduz.az,https://www.ulduz.az
PRICE_AZN=1.00
# "test" marks orders paid immediately (no real payment) — ONLY for testing. Remove or set to "epoint" for launch.
PAYMENT_MODE=test
EPOINT_PUBLIC_KEY=i000000001
EPOINT_PRIVATE_KEY=your-epoint-private-key
# Optional: EPOINT_BASE_URL=https://epoint.az   MAX_ORDERS_PER_IP_HOUR=10
